# Required
TELEGRAM_BOT_TOKEN=123456:ABC...
NOTES_CHANNEL_ID=-100...
GEMINI_API_KEY=your-gemini-key

# Supabase (leave empty to use a local SQLite file)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Vercel only
WEBHOOK_SECRET=           # any long random string; also passed to Telegram by `python bot.py set-webhook`
CRON_SECRET=              # any long random string; Vercel sends it on cron calls

# Optional
REVIEW_CHAT_ID=           # where scheduled drafts go; defaults to whoever first messages the bot privately
MIN_SCORE=6
TIMEZONE=Asia/Kolkata
DRAFT_DAYS=mon,wed,fri    # local runner only; on Vercel the schedule is in vercel.json
DRAFT_TIME=08:00
GEMINI_DRAFT_MODEL=gemini-pro-latest
GEMINI_TRIAGE_MODEL=gemini-flash-latest
