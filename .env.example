# Required
TELEGRAM_BOT_TOKEN=123456:ABC...
NOTES_CHANNEL_ID=-100...
GEMINI_API_KEY=your-gemini-key

# Optional
REVIEW_CHAT_ID=          # where drafts go; defaults to the notes channel
DRAFT_DAYS=mon,wed,fri
DRAFT_TIME=08:00
TIMEZONE=Asia/Kolkata
MIN_SCORE=6              # notes below this score are never auto-drafted
TRIAGE_REPLIES=true      # reply to each note with its score
GEMINI_DRAFT_MODEL=gemini-pro-latest
GEMINI_TRIAGE_MODEL=gemini-flash-latest
